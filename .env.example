# Supabase – get these from your project dashboard (Settings > API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# The *publishable* key (sb_publishable_...). Safe in the browser; RLS protects data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key

# No secret/service-role key is needed: the app only uses the publishable key.

